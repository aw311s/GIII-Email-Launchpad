# Workzone OAuth
WORKZONE_CLIENT_ID=
WORKZONE_CLIENT_SECRET=
WORKZONE_TOKEN_URL=https://your-workzone-host.example/api/token
WORKZONE_API_BASE_URL=https://your-workzone-host.example/api

# Microsoft Graph / SharePoint app credentials
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# Paths inside the configured SharePoint document library
SHAREPOINT_WORKBOOK_PATH_DKNY=
SHAREPOINT_WORKBOOK_PATH_KARL=
SHAREPOINT_WORKBOOK_PATH_DONNA=

# Existing Klaviyo configuration
KLAVIYO_API_KEY_DKNY=
KLAVIYO_API_KEY_KARL=
KLAVIYO_API_KEY_DONNA=

# Box currently uses public shared links through Playwright.
# Keep this value until IT supplies and approves official Box API credentials.
BOX_INTEGRATION_MODE=playwright
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=

# Temporary deployment access gate (remove after Entra is implemented)
APP_AUTH_MODE=basic
APP_ACCESS_USERNAME=
APP_ACCESS_PASSWORD=

# Optional only when the frontend is hosted on a different origin
CORS_ORIGIN=
