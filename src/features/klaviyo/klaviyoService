function escapeHtml(value) {
  return String(value || "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#39;");
}

export function buildPrelinkedEmailHtml(campaign) {
  const slices = campaign?.box?.slices || [];
  const items = campaign?.workbook?.items || [];

  return slices
    .map((slice, index) => {
      const link = items[index]?.link || "";
      const src = slice?.url || "";
      const name = slice?.name || `slice-${index + 1}`;

      const img = `<img src="${escapeHtml(src)}" alt="${escapeHtml(name)}" style="display:block;width:100%;height:auto;border:0;outline:none;text-decoration:none;" />`;

      if (link) {
        return `<a href="${escapeHtml(link)}" target="_blank" rel="noreferrer" style="display:block;text-decoration:none;">${img}</a>`;
      }

      return img;
    })
    .join("\n");
}

